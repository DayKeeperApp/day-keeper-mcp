# Day Keeper MCP Server Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Day Keeper API (required)
DAY_KEEPER_API_URL=
DAY_KEEPER_TENANT_ID=
DAY_KEEPER_API_KEY=

# MCP Transport (optional)
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=3001

# Defaults (optional)
DAY_KEEPER_DEFAULT_SPACE_ID=
DAY_KEEPER_DEFAULT_TIMEZONE=UTC

# Logging (optional)
LOG_LEVEL=info
